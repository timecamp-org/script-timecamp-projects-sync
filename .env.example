
TIMECAMP_API_TOKEN=your_timecamp_api_token_found_in_user_profile
# Optional: source TimeCamp account token for fetch_timecamp.py.
TIMECAMP_API_TOKEN_FETCH=your_source_timecamp_api_token
TIMECAMP_TASK_ID=your_timecamp_task_id_for_redmine_projects_like_170066189
# Optional: skip assigning mandatory tags to a task when more than this many
# mandatory tags would need to be added. Leave empty/unset for no limit.
# TIMECAMP_MAX_MANDATORY_TAGS_TO_ADD=1

# AZUREDEVOPS integration
# AZUREDEVOPS_INSTANCES=Company1:https://dev.azure.com/company1:token1,Company2:https://dev.azure.com/company2:token2
AZUREDEVOPS_INSTANCE1_NAME=MyCompany
AZUREDEVOPS_INSTANCE1_URL=https://dev.azure.com/mycompany
AZUREDEVOPS_INSTANCE1_TOKEN=your_personal_access_token
AZUREDEVOPS_INSTANCE2_NAME=MyCompany2
AZUREDEVOPS_INSTANCE2_URL=https://dev.azure.com/mycompany
AZUREDEVOPS_INSTANCE2_TOKEN=your_personal_access_token2

# REDMINE integration
REDMINE_URL=https://your-redmine-instance.com
REDMINE_API_KEY=your_redmine_api_key_found_in_user_profile
REDMINE_ACTIVITY_ID=your-default-activity-id

# Harvest integration
HARVEST_ACCESS_TOKEN=your_harvest_personal_access_token
HARVEST_ACCOUNT_ID=your_harvest_account_id
# Optional: default Harvest task ID for time entries (if not set, uses first task assignment on each project)
# HARVEST_DEFAULT_TASK_ID=your_default_task_id

# Jira integration
JIRA_INSTANCES='[{"name": "Jira Instance 1", "url": "https://your-domain.atlassian.net", "email": "your-email@example.com", "token": "your-api-token"}, {"name": "Jira Instance 2", "url": "https://another-domain.atlassian.net", "email": "your-email@example.com", "token": "another-api-token"}]'
# Optional: Jira Cloud API tokens keyed by user email, then Jira instance URL.
# Used with export_time_entries_jira.py --user-email; matching is case-insensitive.
# JIRA_USER_API_TOKENS='{"person@example.com":{"https://your-domain.atlassian.net":"their-first-token","https://another-domain.atlassian.net":"their-second-token"}}'
# Shorthand when one token works on every instance:
# JIRA_USER_API_TOKENS='{"person@example.com":"their-jira-api-token"}'
# Optional: format Jira issue names as "[TCD-123] Task name".
# JIRA_PREFIX_ISSUE_KEY_TO_TASK_NAME=true

# Zendesk integration
ZENDESK_INSTANCES='[{"name": "Zendesk Support", "url": "https://your-domain.zendesk.com", "email": "your-email@example.com", "token": "your-api-token"}]'
# Or single-instance variables:
# ZENDESK_NAME=Zendesk Support
# ZENDESK_URL=https://your-domain.zendesk.com
# ZENDESK_EMAIL=your-email@example.com
# ZENDESK_API_TOKEN=your-api-token

# Datadog integration
DATADOG_API_KEY=your_datadog_api_key
DATADOG_APP_KEY=your_datadog_application_key
# Optional: Datadog site domain. Defaults to datadoghq.com (US1).
# DATADOG_SITE=datadoghq.eu

# Monday.com integration
MONDAY_API_TOKEN=your_monday_api_token
# Optional: comma-separated board IDs. If omitted, all non-subitem boards are fetched.
# MONDAY_BOARD_IDS=123456789,987654321
# Optional: comma-separated Monday column titles to export as meandatory_tags.
# MONDAY_MEANDATORY_TAGS=Client,CoE
